{
  "github": {
    "account": "your-github-handle",
    "tokenEnv": "",
    "enforce": "writes"
  },
  "git": {
    "protectedBranches": [
      "main",
      "master"
    ],
    "branch": {
      "maxLength": 40,
      "forbidSubstrings": [
        "your-github-handle"
      ],
      "rules": [
        {
          "repos": [
            "some-org/repo-with-short-branches"
          ],
          "maxLength": 7
        }
      ]
    }
  },
  "shipGate": {
    "enabled": true,
    "ttlMinutes": 30,
    "excludeRepos": []
  },
  "planGate": {
    "enabled": true,
    "maxUnplannedFiles": 2,
    "contractFiles": [
      "package.json",
      "wrangler.toml",
      "wrangler.json",
      "wrangler.jsonc",
      "fstab.yaml",
      ".github/workflows/"
    ],
    "excludeRepos": []
  },
  "dev": {
    "model": "claude-opus-5.5",
    "claudeModel": "opus",
    "setDefaults": true
  },
  "review": {
    "codeModel": "gpt-6.1-sol",
    "securityModel": "gpt-6.1-sol",
    "claudeCrossFamily": true,
    "maxFixRounds": 2
  },
  "localDir": "~/.dev-harness/local"
}
