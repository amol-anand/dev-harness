#!/usr/bin/env node
// git credential helper for https://github.com — the only helper git calls for that host.
// get:   configured account's token; if none, delegate to the helpers that were configured before install.
// store/erase: forwarded to those helpers only for credentials that did not come from the harness.
import { loadConfig } from '../lib/config.mjs';
import { resolveToken } from '../lib/identity.mjs';
import { readChain, runHelper } from '../lib/credential.mjs';

const op = process.argv[2];
let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => { input += c; });
process.stdin.on('end', () => {
  const attrs = Object.fromEntries(input.split('\n').filter((l) => l.includes('='))
    .map((l) => [l.slice(0, l.indexOf('=')), l.slice(l.indexOf('=') + 1)]));
  if (attrs.host !== 'github.com' || (attrs.protocol && attrs.protocol !== 'https')) return;
  let token = '';
  let cfg = null;
  try { cfg = loadConfig(); token = resolveToken(cfg); } catch { /* delegate */ }
  if (op === 'get') {
    if (token) {
      process.stdout.write(`username=${cfg.github.account || 'x-access-token'}\npassword=${token}\n`);
      return;
    }
    for (const spec of readChain()) {
      const out = runHelper(spec, 'get', input);
      if (/^password=/m.test(out)) { process.stdout.write(out); return; }
    }
    return;
  }
  if ((op === 'store' || op === 'erase') && (!token || attrs.password !== token)) {
    for (const spec of readChain()) runHelper(spec, op, input);
  }
});
